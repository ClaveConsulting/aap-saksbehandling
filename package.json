{
  "name": "aap-saksbehandling",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo | pino-pretty",
    "build": "next build",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "test:watch": "vitest --watch",
    "start": "next start",
    "lint": "eslint app components context hooks lib",
    "gentypes:behandlingsflyt": "openapi-typescript http://localhost:8080/openapi.json -o lib/types/schema.d.ts && prettier --write lib/types/schema.d.ts",
    "gentypes:ci": "openapi-typescript ./openapi.json -o lib/types/schema.d.ts && prettier --write lib/types/schema.d.ts",
    "gentypes:postmottak": "openapi-typescript http://localhost:8070/openapi.json -o lib/types/postmottakSchema.d.ts && prettier --write lib/types/postmottakSchema.d.ts",
    "gentypes:oppgave": "openapi-typescript http://localhost:8084/openapi.json -o lib/types/oppgaveSchema.d.ts && prettier --write lib/types/oppgaveSchema.d.ts",
    "gentypes:all": "yarn gentypes:behandlingsflyt && yarn gentypes:postmottak && yarn gentypes:oppgave",
    "run-prettier": "prettier --write .",
    "gen-umami-docs": "node scripts/generate-umami-docs.mjs"
  },
  "prettier": "@navikt/aap-felles-prettier",
  "dependencies": {
    "@grafana/faro-web-sdk": "2.11.0",
    "@grafana/faro-web-tracing": "2.11.0",
    "@navikt/aap-breveditor": "0.13.0",
    "@navikt/aap-breveditor-css": "0.6.0",
    "@navikt/aksel-icons": "8.16.2",
    "@navikt/diagnosekoder": "1.2026.0",
    "@navikt/ds-css": "8.16.2",
    "@navikt/ds-react": "8.16.2",
    "@navikt/endringslogg": "2.0.1",
    "@navikt/oasis": "4.1.4",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/api-logs": "0.222.0",
    "@portabletext/react": "6.2.0",
    "@testing-library/user-event": "14.6.6",
    "@umami/node": "0.4.0",
    "@vercel/otel": "2.1.3",
    "date-fns": "4.4.0",
    "fuse.js": "7.5.0",
    "i18n-iso-countries": "7.14.0",
    "is-european": "1.0.12",
    "jose": "6.2.10",
    "lodash": "4.18.1",
    "next": "16.3.2",
    "node-loader": "2.1.0",
    "pino": "10.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-select": "5.10.2",
    "server-only": "0.0.1",
    "swr": "2.5.1",
    "unleash-client": "6.12.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@navikt/aap-felles-prettier": "6.3.2",
    "@navikt/aksel": "8.16.2",
    "@navikt/eslint-config-aap": "6.1.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/lodash": "4.17.24",
    "@types/node": "25.9.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-n": "17.24.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "happy-dom": "20.11.6",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "openapi-typescript": "7.13.0",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11",
    "vitest-fetch-mock": "0.4.5"
  },
  "lint-staged": {
    "*.{js,ts,tsx}": "eslint --cache --fix",
    "*.{js,ts,tsx,css,md}": "prettier --write"
  },
  "packageManager": "yarn@4.12.0"
}
